
component NoiseButton inherits Rectangle {
 in property <string> label; in property <string> hint; in property <bool> selected;
 in property <color> accent;
 callback clicked();
 height: 72px; border-radius: 16px;
 background: touch.pressed ? root.accent.with-alpha(0.28) : root.selected ? root.accent.with-alpha(0.16) : touch.has-hover ? #283334 : #1b2627;
 border-width: 1px; border-color: root.selected ? root.accent.with-alpha(0.7) : #354344;
 animate background, border-color { duration: 220ms; easing: ease-in-out; }
 Text { x: 20px; y: 14px; text: root.label; color: root.selected ? root.accent : #e5eceb; font-size: 17px; font-weight: 600; }
 Text { x: 20px; y: 40px; text: root.hint; color: #9aabaa; font-size: 12px; }
 Text { x: parent.width - 44px; width: 24px; height: parent.height; vertical-alignment: center; text: root.selected ? "Ⅱ" : "▷"; color: root.accent; font-size: 22px; }
 touch := TouchArea { clicked => { root.clicked(); } }
 accessible-role: button; accessible-label: label; accessible-action-default => { root.clicked(); }
}
component WindowAction inherits Rectangle {
 in property <string> label;
 in property <image> icon;
 in property <color> accent;
 callback clicked();
 width: 56px; height: 56px; border-radius: 16px;
 border-width: 1px; border-color: touch.has-hover ? root.accent.with-alpha(0.7) : #354344;
 background: touch.pressed ? root.accent.with-alpha(0.28) : touch.has-hover ? #283334 : #1b2627;
 animate background, border-color { duration: 220ms; easing: ease-in-out; }
 drop-shadow-offset-y: 6px; drop-shadow-blur: 24px; drop-shadow-color: #0005;
 Image { x: 16px; y: 16px; width: 24px; height: 24px; source: root.icon; colorize: root.accent; }
 accessible-role: button; accessible-label: root.label; accessible-action-default => { root.clicked(); }
 forward-focus: focus;
 focus := FocusScope {
  key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
 }
 if focus.has-focus : Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; border-radius: 19px; border-width: 1px; border-color: root.accent; background: transparent; }
 Tooltip { text: @markdown("\{root.label}"); }
 touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
export component App inherits Window {
 title: "fi-focus"; icon: @image-url("icon.png"); preferred-width: 420px; preferred-height: 356px; min-width: root.show-window-border ? 420px : 320px; min-height: 356px;
 max-width: root.show-window-border ? 420px : 65535px; max-height: root.show-window-border ? 356px : 65535px;
 no-frame: true; resize-border-width: root.show-window-border ? 0px : 7px; background: root.show-window-border ? transparent : #111a1b;
 in-out property <int> active: 0;
 in property <bool> show-window-border: false;
 in property <bool> android-layout: false;
 callback minimize-app(); callback select(int); callback close-app(); callback drag(float, float);
 property <color> accent: active == 2 ? #edb4c7 : active == 3 ? #ceaa88 : #dce8e7;
 animate accent { duration: 450ms; easing: ease-in-out; }
 Rectangle { width: parent.width; height: parent.height; background: #111a1b; border-radius: root.show-window-border ? 12px : 0px; }
 Rectangle { width: parent.width; height: parent.height; background: root.android-layout ? @linear-gradient(150deg, root.accent.mix(#111a1b, 0.10), #111a1b 70%) : @linear-gradient(150deg, root.accent.with-alpha(0.10), #111a1b 70%); border-width: root.show-window-border ? 1px : 0px; border-color: #657272; border-radius: root.show-window-border ? 12px : 0px; }
 VerticalLayout { x: max(24px, (parent.width - 460px)/2); y: 24px + (root.android-layout ? root.safe-area-insets.top : 0px); width: min(parent.width - 48px, 460px); height: 240px; spacing: 12px;
 NoiseButton { label: "White"; hint: "Jernih dan merata"; accent: #dce8e7; selected: root.active == 1; clicked => { root.select(1); } }
 NoiseButton { label: "Pink"; hint: "Lembut dan seimbang"; accent: #edb4c7; selected: root.active == 2; clicked => { root.select(2); } }
 NoiseButton { label: "Brown"; hint: "Dalam dan hangat"; accent: #ceaa88; selected: root.active == 3; clicked => { root.select(3); } }
 }
 HorizontalLayout { x: max(24px, (parent.width - 460px)/2); y: root.android-layout ? max(276px, parent.height - 80px) : 276px; width: min(parent.width - 48px, 460px); spacing: 12px; height: 56px;
 Rectangle {
  horizontal-stretch: 1; height: 56px; background: transparent;
  Rectangle { x: 0px; y: (parent.height - 48px)/2; width: 48px; height: 48px; border-radius: 12px; clip: true;
   Image { width: parent.width; height: parent.height; source: @image-url("logo.png"); image-fit: contain; }
  }
  VerticalLayout { x: 58px; y: (parent.height - 36px)/2 + 2px; width: parent.width - 58px; height: 36px; spacing: 2px;
   Text { text: "fi-focus"; color: #e5eceb; font-size: 18px; font-weight: 600; }
   Text { text: "v0.1"; color: #9aabaa; font-size: 11px; }
  }
  TouchArea { moved => { if self.pressed { root.drag((self.mouse-x - self.pressed-x)/1px, (self.mouse-y - self.pressed-y)/1px); } } }
 }
 WindowAction { label: "Minimalkan"; icon: @image-url("minimize.svg"); accent: root.accent; clicked => { root.minimize-app(); } }
 WindowAction { label: "Tutup"; icon: @image-url("close.svg"); accent: root.accent; clicked => { root.close-app(); } }
 }
}
